# O administrador é criado na primeira execução em localhost.
# Opcional: guarde as chaves locais fora do diretório de dados, com acesso restrito.
SHOP_KEYS_DIR=

# URL pública exata da loja (HTTPS em produção).
SHOP_URL=http://localhost:3000
# Em produção, forneça os arquivos PEM para servir HTTPS diretamente.
TLS_KEY_PATH=
TLS_CERT_PATH=

# Google Sheets: mantenha false até criar a planilha e configurar a conta de serviço.
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=Pedidos
# Caminho absoluto para o JSON da conta de serviço; mantenha o arquivo fora do repositório.
GOOGLE_APPLICATION_CREDENTIALS=
